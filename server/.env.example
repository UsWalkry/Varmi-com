########################################
# Varmı Mail Server (.env.example)
# Kopyalayın: cp .env.example .env ve değerleri doldurun
########################################

# 🔒 SECURITY - CRITICAL
NODE_ENV=development  # production için 'production' yapın
JWT_SECRET=CHANGE-THIS-TO-STRONG-256-BIT-RANDOM-KEY  # ÇOK ÖNEMLİ: Değiştirin!

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=varmi_db

# SMTP sunucu ayarları
SMTP_HOST=mail.varmii.com
SMTP_PORT=587
# 465 için true (SMTPS/implicit TLS), 587/STARTTLS için genelde false
SMTP_SECURE=false
SMTP_USER=noreply@varmii.com
SMTP_PASS=your_smtp_password

# Gönderen bilgileri
MAIL_FROM_NAME=Varmii
MAIL_FROM_EMAIL=noreply@varmii.com

# Frontend URL (e-posta linklerinde kullanılır ve CORS whitelist)
FRONTEND_URL=https://varmii.com

# Sunucu portu/host
PORT=8787
HOST=0.0.0.0

# HTTPS kullanımı (true ise ssl/cert.pem ve ssl/key.pem gerekli)
USE_HTTPS=true

# Frontend URL (e-posta linklerinde kullanılır)
FRONTEND_URL=https://varmii.com
# Alternatif: BASE_URL=https://varmii.com

# Geliştirme logları
DEBUG_MAIL=false
# SMTP settings (SMTP_* veya MAIL_* değişkenlerinden biri set edilebilir)
# Örnek: Kullanıcının verdiği formata uygun
MAIL_DRIVER=smtp
MAIL_HOST=mail.varmii.com
MAIL_PORT=587
MAIL_SECURE=tls         # 465=ssl, 587=tls
MAIL_USER=noreply@varmii.com
MAIL_PASS=your_mail_password
MAIL_FROM_EMAIL=noreply@varmii.com
MAIL_FROM_NAME=varmii.com

# Alternatif isimlendirme (aynı ayarlar):
# SMTP_HOST=smtp.example.com # Ör: smtp.varmi.com veya sağlayıcınızın hostu
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@varmi.com
# SMTP_PASS=
# MAIL_FROM_NAME=Varmı
# MAIL_FROM_EMAIL=noreply@varmi.com
MAIL_API_KEY=change-this-key

# App server port
PORT=8787

# 🔔 Firebase Cloud Messaging (FCM) — background push notifications
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Minify the JSON to a single line and paste it here.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
