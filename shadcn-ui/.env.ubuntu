# Frontend Environment Variables - Ubuntu Server Production

# Server URL (Ubuntu server IP'nizi yazın)
VITE_SERVER_URL=https://192.168.1.100:8787
VITE_API_BASE_URL=https://192.168.1.100:8787/api
VITE_MAIL_API_BASE=https://192.168.1.100:8787/api

# Port (production'da Nginx 443 portunda dinler)
VITE_PORT=443

# Debug mode - production için false
VITE_DEBUG_MODE=false

# Sentry (opsiyonel)
# VITE_SENTRY_DSN=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature flags
VITE_ENABLE_SOURCE_LOCATOR=false

# ⚠️  ÖNEMLI:
# - 192.168.1.100 yerine Ubuntu server'ınızın gerçek IP adresini yazın
# - Build öncesi bu dosyayı shadcn-ui/.env olarak kaydedin
# - Veya domain kullanıyorsanız: https://varmii.com şeklinde değiştirin
