              />
            </div>
            
            <div className="grid grid-cols-4 items-center gap-4">
              <label htmlFor="carrier" className="text-right">
                Kargo �irketi
              </label>
              <Input
                id="carrier"
                placeholder="Kargo �irketi"
                className="col-span-3"
