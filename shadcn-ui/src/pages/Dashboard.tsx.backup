                                <div className="flex items-center gap-4">
                                  <Badge variant="outline" className="border-red-500 text-red-700 bg-red-50">
                                    ?? Favori
                                  </Badge>
                                  {listing.status && (
                                    <span className="text-xs text-gray-600 capitalize">
