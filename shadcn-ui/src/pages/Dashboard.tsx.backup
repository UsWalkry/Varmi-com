                                    {formatPriceShort(listing.budgetMax || listing.price || 0)}
                                  </span>
                                  {listing.budgetMin && listing.budgetMin !== listing.budgetMax && (
                                    <span className="text-sm text-gray-500">
                                      - {formatPriceShort(listing.budgetMin)}
                                    </span>
                                  )}
