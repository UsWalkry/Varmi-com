                  <SelectValue placeholder="Durum se�in" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="preparing">Haz�rlan�yor</SelectItem>
                  <SelectItem value="shipped">Kargoya Verildi</SelectItem>
