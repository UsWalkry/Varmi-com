            </div>
          </div>
        </DialogContent>
      </Dialog>

      {/* Shipping Form Modal */}
      {selectedSale && (
        <ShippingFormModal
          isOpen={showShippingModal}
          onClose={() => {
            setShowShippingModal(false);
            setSelectedSale(null);
