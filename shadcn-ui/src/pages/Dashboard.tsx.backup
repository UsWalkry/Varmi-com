                      'preparing': 'Haz�rlan�yor',
                      'shipped': 'Kargoda',
                      'delivered': 'Teslim Edildi',
                      'completed': 'Tamamland�',
                      'cancelled': '�ptal Edildi'
                    };
                    return statusMap[status] || status;
