                                <div className="text-sm font-medium text-gray-700 mb-1">�deme Durumu</div>
                                <div className="flex items-center gap-1">
                                  {sale.paymentStatus === 'paid' ? (
                                    <>
                                      <CreditCard className="h-4 w-4 text-green-600" />
                                      <span className="text-sm text-green-600">�dendi</span>
