                                    const targetId = (listing as any).listing_id || listing.id;
                                    console.log('?? Navigating to listing:', { 
                                      originalListing: listing, 
                                      targetId,
                                      listing_id: (listing as any).listing_id,
                                      id: listing.id 
                                    });
                                    navigate(`/listing/${targetId}`);
                                  }}
                                >
                                  G�r�nt�le
                                </Button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </CardContent>
                    </Card>
                  );
                })}
              </div>
            )}
          </TabsContent>
        </Tabs>
      </div>

      {/* Status Update Modal */}
      <Dialog open={showStatusModal} onOpenChange={setShowStatusModal}>
        <DialogContent className="sm:max-w-[425px]">
          <DialogHeader>
            <DialogTitle>Sipari� Durumu G�ncelle</DialogTitle>
            <DialogDescription>
              Sipari� #{selectedSale?.id} i�in durum g�ncellemesi yap�n
