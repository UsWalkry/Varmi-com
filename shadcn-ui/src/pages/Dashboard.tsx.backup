                  <Heart className="h-12 w-12 text-muted-foreground mb-4" />
                  <p className="text-lg font-medium text-muted-foreground mb-2">Hen�z favori �r�n�n yok</p>
                  <p className="text-sm text-muted-foreground mb-4">Be�endi�in �r�nleri favorilere ekle!</p>
                  <Button onClick={() => navigate('/')}>
                    �r�nleri Ke�fet
                  </Button>
                </CardContent>
