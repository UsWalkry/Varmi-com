{
  "name": "Varmii - İhtiyacınızı İlan Edin",
  "short_name": "Varmii",
  "description": "İhtiyacınızı ilan edin, satıcılar size teklif versin. Türkiye'nin en yenilikçi pazaryeri platformu.",
  "lang": "tr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#9333EA",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "data:image/png;base64,",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAgAAAAIACAYAAAD0eNT6AAAACXBIWXMAAAsTAAALEwEAmpwYAAAMbklEQVR4nO3dXYhc1RnA8TPZbHYzmyRN0o+kaRPTWq0f9UOttlpbW7VqH1Twww+oL/rgBx9Ef", 
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "İlan Oluştur",
      "short_name": "İlan",
      "description": "Yeni ilan oluştur",
      "url": "/dashboard?action=create",
      "icons": [{ "src": "/favicon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Hesabım",
      "short_name": "Profil",
      "description": "Hesap ayarlarını görüntüle",
      "url": "/profile",
      "icons": [{ "src": "/favicon.svg", "sizes": "96x96" }]
    },
    {
      "name": "Teklifler",
      "short_name": "Teklifler",
      "description": "Gelen teklifleri görüntüle",
      "url": "/offers",
      "icons": [{ "src": "/favicon.svg", "sizes": "96x96" }]
    }
  ],
  "categories": ["shopping", "marketplace", "e-commerce"],
  "dir": "ltr",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "prefer_related_applications": false
}
